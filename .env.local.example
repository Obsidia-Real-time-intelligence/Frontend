# ──────────────────────────────────────────────────────────────────
# Obsidia frontend env vars (web/.env.local)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────────

# ── Supabase (auth + waitlist + strategies + alerts) ────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Backend FastAPI (backtest endpoint) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Telegram (server-only — used by /api/waitlist for founder ping) ──
# Create a bot: @BotFather → /newbot → copy the token
# Get your chat ID: message your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the chat.id from the JSON response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Stripe (server-only) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TRADER=price_...
STRIPE_PRICE_QUANT=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
