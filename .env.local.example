# ──────────────────────────────────────────────────────────────────
# Obsidia frontend env vars (web/.env.local)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ──────────────────────────────────────────────────────────────────

# ── Supabase (auth + waitlist + strategies + alerts) ────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key — server-only. Used by /api/account/delete (admin auth).
# Keep this secret; never expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Backend FastAPI (backtest endpoint) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Telegram (server-only — used by /api/waitlist for founder ping) ──
# Create a bot: @BotFather → /newbot → copy the token
# Get your chat ID: message your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the chat.id from the JSON response.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord (server-only — admin webhook for waitlist + alerts) ──
# Discord channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# ── SMTP email (server-only — waitlist confirmation + admin alerts) ──
# Gmail: use an app password (https://myaccount.google.com/apppasswords)
# Resend: smtp.resend.com / 465 / "resend" / API key
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Obsidia <hello@obsidia.app>"
# Optional — admin recipient. Defaults to EMAIL_FROM if unset.
EMAIL_ADMIN_TO=

# ── Stripe (server-only) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TRADER=price_...
STRIPE_PRICE_QUANT=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Public community invite links (shown to waitlist signups) ───
# These are PUBLIC — safe to ship to the browser.
NEXT_PUBLIC_TELEGRAM_INVITE=https://t.me/your_channel
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/your_invite
